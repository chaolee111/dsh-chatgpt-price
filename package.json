{
  "name": "dsh-chatgpt-price",
  "version": "0.4.1",
  "description": "ChatGPT per-country subscription price board for DeepSeek Harness: Plus/Go/Pro prices read from each country's App Store every day, converted to CNY at the live USD rate, with a Settings page and an optional sidebar tab.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaolee111/dsh-chatgpt-price.git"
  },
  "homepage": "https://github.com/chaolee111/dsh-chatgpt-price#readme",
  "bugs": {
    "url": "https://github.com/chaolee111/dsh-chatgpt-price/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "chatgpt",
    "pricing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
